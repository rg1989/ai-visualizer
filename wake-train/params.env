# Run parameters, read by the params job. Push a change to this file on the
# wake-train branch to start a run. Smoke: 1/200/1/200. Real: 4/20000/40/50000.
# ACAV_CHUNKS x 50k negatives: 40 = 2M examples = 6.1 GB, ~720 h of audio, fits the
# runner's page cache. The smoke run trained at ~90 steps/s, so 50k steps is minutes.
SHARDS=4
N_SAMPLES=20000
ACAV_CHUNKS=40
STEPS=50000
